{
  // ESLint установлен не в корне репозитория, а в server/node_modules,
  // поэтому расширению нужно явно указать рабочий каталог для файлов server/**.
  "eslint.workingDirectories": [{ "directory": "server", "changeProcessCWD": true }],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "eslint.probe": ["javascript", "javascriptreact", "typescript", "typescriptreact"]
}
